{
  "name": "live-survivors",
  "version": "0.1.0",
  "description": "Jogo de sobrevivência 2D para transmissões do TikTok LIVE, exibido pelo OBS Studio.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && node dist-server/server/main.js",
    "dev:server": "npm run build:server && node dist-server/server/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
